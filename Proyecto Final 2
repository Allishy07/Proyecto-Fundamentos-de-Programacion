def volumen_total(p_ejercicio,num_series,num_rep):
    if p_ejercicio > 0 and num_series > 0 and num_rep > 0 :
        v_total = p_ejercicio * num_series * num_rep
        return v_total
    else :
        print("Dato no valido") 


def repeticion_max(num_rep,p_ejercicio):
    if num_rep > 0 and p_ejercicio > 0 :
        r_max = ((num_rep / 30) + 1) * p_ejercicio
        return r_max
    else : 
       print("Dato no valido")  

def repeticiones_totales(num_series,num_rep):
    if num_series > 0 and num_rep > 0 :
        rep_totales = (num_series * num_rep)
        return rep_totales
    else :
        print("Dato no valido")  

